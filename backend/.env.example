# Relative SQLite paths are anchored to the backend directory, regardless of
# the directory from which the API process is started.
DATABASE_URL=sqlite:///./recode.db
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set APP_ENV=production, RECODE_REQUIRE_AUTH=true, and strong private values
# for RECODE_AUTH_PASSWORD and RECODE_SESSION_SECRET before exposing the API.
APP_ENV=development
RECODE_REQUIRE_AUTH=false
RECODE_AUTH_PASSWORD=
RECODE_SESSION_SECRET=
RECODE_SEED_DEMO_DATA=true
